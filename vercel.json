{
  "functions": {
    "api/sofascore-proxy/[...path].js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/sofascore-proxy/:path*",
      "destination": "/api/sofascore-proxy/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
